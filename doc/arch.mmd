    %% CONNECTIONS & CONTROL FLOW
    %% -------------------------------------------------------------
    GDBClient --- USB_GDB
    GDBClient --- TCP_Socket
    Console --- USB_UART

    USB_GDB --- StreamDecoder
    TCP_Socket --- StreamDecoder
    PacketEncoder --- USB_GDB
    PacketEncoder --- TCP_Socket

    StreamDecoder --> CmdDispatcher
    CmdDispatcher --> PacketEncoder

    CmdDispatcher --> CmdRun
    CmdDispatcher --> CmdMem
    CmdDispatcher --> CmdReg
    CmdDispatcher --> CmdBkpt
    CmdDispatcher --> CmdFlash
    CmdDispatcher --> CmdMon
    CmdDispatcher --> CmdQuery

    CmdFlash --> FlashSubsystem
    CmdRun --> TargetSubsystem
    CmdMem --> TargetSubsystem
    CmdReg --> TargetSubsystem

    CmdMem --> MemCache
    CmdBkpt --> SWBkptMgr
    CmdMon --> SettingsKV
    CmdMon --> SyncCellState
    CmdQuery --> FreeRTOSEngine
    CmdQuery --> RTTEngine
    CmdQuery --> TargetXML
    CmdQuery --> MemMapXML
    TargetXML --> XmlSink
    MemMapXML --> XmlSink
    XmlSink --> PacketEncoder
    TargetXML --> RustFFI
    MemMapXML --> RustFFI

    FreeRTOSEngine --> TCBList
    FreeRTOSEngine --> ThreadIDMap
    FreeRTOSEngine --> CoreContext

    CmdDispatcher --> RustFFI
    MemCache --> RustFFI
    SWBkptMgr --> RustFFI
    FreeRTOSEngine --> RustFFI
    RTTEngine --> RustFFI
    CmdMon --> RustFFI
    CmdRun --> RustFFI
    CmdReg --> RustFFI

    %% Rust Core Subsystems -> C-ABI Layer
    FlashSubsystem --> CABIFlash
    TargetSubsystem --> CABITarget
    RustFFI --> TargetSubsystem
    RustFFI --> FlashSubsystem
    RustFFI --> BMPBridge

    %% C-ABI & Helpers interop
    BMPHelpers --> CABITarget
    BMPHelpers --> CABIFlash
    BMPBridge --> VendorTargets
    BMPBridge --> ArchDrivers

    %% Dispatch to Blackmagic C Targets & Architecture Drivers
    CABITarget --> VendorTargets
    CABITarget --> ArchDrivers
    CABIFlash --> VendorTargets

    %% Architecture Drivers -> CoreSight / DTM
    CortexM --> ADIv5
    RISCVCore --> RISCV_DTM

    %% CoreSight / DTM -> Wire Protocols
    ADIv5 --> SWD_Transport
    ADIv5 --> JTAG_Transport
    RISCV_DTM --> SWD_Tap
    RISCV_DTM --> RVSWD_Tap
    RISCV_DTM --> SDI_Tap
    RISCV_DTM --> JTAG_Transport

    %% Wire Protocol Drivers -> Swindle Platform TAP Drivers
    SWD_Transport --> SWD_Tap
    SPI_SFDP --> Generic_Tap
    JTAG_Transport --> Generic_Tap

    %% Swindle Platform TAP Drivers -> Physical Pins
    SWD_Tap --> GPIO_PIO
    RVSWD_Tap --> GPIO_PIO
    SDI_Tap --> GPIO_PIO
    Generic_Tap --> GPIO_PIO
    ResetPin --> GPIO_PIO
    ADC_Sense --> GPIO_PIO

    GPIO_PIO --> TargetMCU
