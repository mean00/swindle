    %% -------------------------------------------------------------
    subgraph Layer3 ["3. Swindle Protocol & Command Engine (Rust)"]
        StreamDecoder["Packet Decoder (gdb_stream automaton)"]
        PacketEncoder["Packet Encoder & Checksum (encoder)"]
        CmdDispatcher["Command Dispatcher (commands::exec)"]

        subgraph CmdModules ["Command Handlers"]
            CmdRun["Execution Control (vCont, c, s, k)"]
            CmdMem["Memory Access (m, X)"]
            CmdReg["Register Access (g, p, P)"]
            CmdBkpt["Breakpoint & Watchpoint (Z, z)"]
            CmdFlash["Flash Programming (vFlash)"]
            CmdMon["Monitor & Config (mon)"]
            CmdQuery["Queries & XML Target Description (q)"]
        end

        subgraph CoreEngines ["Idiomatic Rust Core Subsystems"]
            FlashSubsystem["Flash Subsystem (rs_swindle::flash)<br/>- FlashManager & Sector Buffer<br/>- Geometry & Multi-block Erase<br/>- FlashDriver Trait<br/>(Replaces target_flash.c)"]
            TargetSubsystem["Target Subsystem (rs_swindle::target)<br/>- TargetRegistry & TargetDriver Trait<br/>- 32-bit RamRegion & Typed Mem Access<br/>- Run Control & Breakwatch<br/>(Replaces target.c)"]
        end

        subgraph XMLGenerators ["XML Streaming Generators (Rust, Zero-Alloc)"]
            TargetXML["Register XML Generator (target_xml.rs)"]
            MemMapXML["Memory Map XML Generator (memory_map_xml.rs)"]
