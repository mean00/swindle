            NordicTargets["nRF51 / nRF91 (nrf51.c, nrf91.c)"]
            LPCTargets["LPC11xx / LPC15xx / LPC17xx (lpc*.c, lpc_common.c)"]
        end

        subgraph ArchDrivers ["CPU Architecture Debug Drivers (blackmagic/src/target/)"]
            CortexM["ARM Cortex-M Debug (cortexm.c, cortex.c)<br/>* Pure In-Band Faults (No setjmp/longjmp)"]
