#
# Write a Rust module holding the flashstub images as `&[u8]` constants.
#
# Script mode, run at build time by the flashstub_rs target:
#   cmake -DOUT=<file.rs> -DBINS=<a.bin>,<b.bin> -P gen_flashstub_rs.cmake
#
# The module is left untouched when its content would not change, so a stub
# rebuild that produces identical bytes does not force a Rust rebuild.
#
if(NOT OUT OR NOT BINS)
  message(FATAL_ERROR "usage: -DOUT=<file.rs> -DBINS=<a.bin>,<b.bin> -P gen_flashstub_rs.cmake")
endif()

string(REPLACE "," ";" BIN_LIST "${BINS}")
set(BYTES_PER_LINE 12)

set(content
    "// @generated by flashstub/CMakeLists.txt -- do not edit by hand.\n//
// In-SRAM flashstub images for the rs_ch32v123xx driver.
// Regenerate: cmake --build blackmagic_addon/target/rs_ch32v123xx/flashstub/build\n")

foreach(bin IN LISTS BIN_LIST)
  get_filename_component(stem "${bin}" NAME_WE)
  string(TOUPPER "${stem}" name)
  file(READ "${bin}" hex HEX)
  string(LENGTH "${hex}" hex_length)
  math(EXPR size "${hex_length} / 2")

  # "aabbcc" -> "0xa, 0xb, ..." in rows of BYTES_PER_LINE, each with a trailing comma
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," pairs "${hex}")
  string(REPLACE "," ";" pairs "${pairs}")
  list(TRANSFORM pairs APPEND ",")
  set(rows "")
  set(index 0)
  while(index LESS size)
    math(EXPR remaining "${size} - ${index}")
    if(remaining GREATER BYTES_PER_LINE)
      set(count ${BYTES_PER_LINE})
    else()
      set(count ${remaining})
    endif()
    list(SUBLIST pairs ${index} ${count} row)
    list(JOIN row " " row_text)
    string(APPEND rows "    ${row_text}\n")
    math(EXPR index "${index} + ${BYTES_PER_LINE}")
  endwhile()

  string(APPEND content
         "\n/// Flashstub image built from `${stem}.c` (${size} bytes).
pub const ${name}_BIN: &[u8] = &[
${rows}];

/// Length in bytes of `${name}_BIN`.
pub const ${name}_BIN_LEN: usize = ${size};

// The image and its declared length must stay in sync.
const _: () = assert!(${name}_BIN.len() == ${name}_BIN_LEN);
")
endforeach()

set(stale TRUE)
if(EXISTS "${OUT}")
  file(READ "${OUT}" previous)
  if(previous STREQUAL content)
    set(stale FALSE)
  endif()
endif()

if(stale)
  file(WRITE "${OUT}" "${content}")
  message(STATUS "${OUT} updated")
else()
  message(STATUS "${OUT} is up to date")
endif()
