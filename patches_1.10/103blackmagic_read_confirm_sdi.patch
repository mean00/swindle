 }
 
+/*
+ * BMP 103: arm or drop the abstractauto stream and, on a transport that cannot be trusted to
+ * deliver the write, make sure it landed. The drop is the one that matters: a lost drop leaves
+ * the stream armed, so the next DATA0 access - the a0/a1 restores at the end of the read -
+ * re-runs a stale command and the register comes back wrong. BMP 100's quiesce stops the drop
+ * racing an executing command; this is about it never having arrived at all. The read-back is a
+ * *register* read, not a data access, so it cannot disturb the stream it is checking.
+ */
+static bool riscv32_autoexec_confirmed_write(riscv_hart_s *const hart, const uint32_t value)
+{
+	uint32_t readback = 0;
+	for (size_t attempt = 0; attempt < RV_AUTOEXEC_CONFIRM_TRIES; ++attempt) {
+		/* The write must not race a command an earlier DATA0 read has just started (BMP 100) */
+		const bool quiesced = riscv_command_wait_complete(hart);
+		if (riscv_dm_write(hart->dbg_module, RV_DM_ABSTRACTAUTO, value) && quiesced &&
+			riscv_dm_read(hart->dbg_module, RV_DM_ABSTRACTAUTO, &readback) && readback == value)
+			return true;
+		riscv_confirm_stats.autoexec++;
+		RV_MEMLOG("riscv: abstractauto = %08" PRIx32 " did not take (read back %08" PRIx32 "), writing it again\n",
+			value, readback);
+	}
+	return false;
+}
+
+/*
+ * Every abstractauto write this file makes goes through here, so the confirmation costs a
+ * transport that can report nothing, and a target on a transport that can keeps the traffic it
+ * had (the drop still goes through the quiescing write BMP 100 introduced).
+ */
+static bool riscv32_autoexec_write(riscv_hart_s *const hart, const uint32_t value)
+{
+	if (hart->dbg_module->dmi_bus->read_confirm)
+		return riscv32_autoexec_confirmed_write(hart, value);
+	if (!value)
+		return riscv32_progbuf_quiesced_write(hart, RV_DM_ABSTRACTAUTO, 0U);
+	return riscv_dm_write(hart->dbg_module, RV_DM_ABSTRACTAUTO, value);
+}
