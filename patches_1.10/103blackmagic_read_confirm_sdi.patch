+#define RV_MEMLOG(...) DEBUG_WARN(__VA_ARGS__)
+#else
+extern bool bmp_mem_log_enabled;
+extern void Logger(const char *fmt, ...);
+#define RV_MEMLOG(...)           \
+	do {                         \
