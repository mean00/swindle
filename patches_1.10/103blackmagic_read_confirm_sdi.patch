 	 * with no per-word polls.
 	 */
-	const bool stream = access_width == RV_MEM_ACCESS_32_BIT && hart->progbuf_size >= 3U;
+	const bool stream = access_width == RV_MEM_ACCESS_32_BIT && hart->progbuf_size >= 3U &&
+		riscv32_progbuf_stream_enabled;
 	/* Fill the program buffer */
 	if (stream) {
 		if (!riscv_dm_write(hart->dbg_module, RV_DM_PROGBUF_BASE + 0U, RV_SW_A1_A0) ||
@@ -1042,6 +1177,203 @@
  * a post-increment; BMP 100 already puts a0 and a1 back whatever the run did, so the retry
  * cannot leave the hart in a different state than the attempt before it did.
  */
+/*
+ * BMP 103: the transfer is not over until the module says it is.
+ *
+ * minichlink ends every bulk read the same way (DefaultWaitForDoneOp(dev, 0) after
+ * DefaultReadBinaryBlob, pgm-wch-linke.c): it looks at the abstraction control/status once more
+ * and refuses the data if a command error is latched. The streaming reader has no such point -
+ * patch 86 reads DATA0 without ever waiting for the command that read starts - so an
+ * autoexec'd access that faulted (an address the module will not reach, a command it rejected,
+ * a hart in the wrong state) is nowhere in the answer the caller is handed. This is that
+ * missing point: one status read per transfer.
+ */
+static void riscv32_check_transfer_complete(riscv_hart_s *const hart)
+{
+	uint32_t status = 0;
+	if (!riscv_dm_read(hart->dbg_module, RV_DM_ABST_CTRLSTATUS, &status))
+		return;
+	if (!((status >> 8U) & RISCV_HART_OTHER))
+		return;
+	hart->status = (status >> 8U) & RISCV_HART_OTHER;
+	riscv_confirm_stats.latched++;
+	RV_MEMLOG("riscv: transfer ended with a command error %u latched (abstractioncs = %08" PRIx32 ")\n",
+		(unsigned)hart->status, status);
+}
+
+/*
+ * Ask the module to drop its command error, and keep asking until it agrees.
+ *
+ * The clear is a write, and the write is what this transport loses: a clear that did not land
+ * leaves the module ignoring every command after it, which is how one dropped frame becomes a
+ * whole window of read failures (patch 102's "one 13 KB window in three faulted, and the same
+ * window read again is clean"). Reading the register back is what tells a clear that landed
+ * from one that did not - minichlink reads it back for the same reason.
+ */
+static bool riscv32_clear_command_error(riscv_hart_s *const hart)
+{
+	uint32_t status = 0;
+	for (size_t attempt = 0; attempt < RV_READ_CONFIRM_TRIES; ++attempt) {
+		if (!riscv_dm_write(hart->dbg_module, RV_DM_ABST_CTRLSTATUS, RISCV_HART_OTHER << 8U))
+			return false;
+		if (!riscv_dm_read(hart->dbg_module, RV_DM_ABST_CTRLSTATUS, &status))
+			return false;
+		if (!(status & (RISCV_HART_OTHER << 8U)))
+			return true;
+	}
+	RV_MEMLOG("riscv: command error %08" PRIx32 " would not clear\n", status);
+	return false;
+}
+
+/*
+ * One unconfirmed pass over a request, through whichever method this hart routes to. Returns
+ * false if the pass did not complete cleanly, having left the module able to be asked again.
+ */
+static bool riscv32_mem_read_once(
+	riscv_hart_s *const hart, void *const dest, const target_addr64_t src, const size_t len)
+{
+	if (hart->flags & RV_HART_FLAG_MEMORY_SYSBUS) {
+		riscv32_sysbus_mem_read(hart, dest, (target_addr_t)src, len);
+		/* BMP 85: a system-bus fault is recorded in the module's control/status, not cmderr */
+		riscv_sysbus_check(hart);
+		return hart->status == RISCV_HART_NO_ERROR;
+	}
+
+	if (hart->flags & RV_HART_FLAG_MEMORY_PROGBUF)
+		riscv32_progbuf_mem_read(hart, dest, src, len);
+	else
+		riscv32_abstract_mem_read(hart, dest, src, len);
+	/* BMP 103: the end-of-transfer check the streaming reader never had */
+	riscv32_check_transfer_complete(hart);
+	if (hart->status == RISCV_HART_NO_ERROR)
+		return true;
+	riscv_confirm_stats.faults++;
+	/*
+	 * A module left with a command error set ignores every command after it, so the error is
+	 * dropped here rather than carried into the re-issue: a clear that landed means the next
+	 * attempt starts from a module that is listening again.
+	 */
+	if (riscv32_clear_command_error(hart))
+		hart->status = RISCV_HART_NO_ERROR;
+	return false;
+}
+
+/*
+ * BMP 103: the evidence this exercise exists for. The two passes disagreed, and here is what
+ * each of them said. A lost access is expected to answer as a zero word (the data register
+ * reads back 0) or as a word belonging to another address, and both are visible in the pair;
+ * the first differing element is kept for `mon riscv_confirm`, and at most four are logged, so
+ * a marginal session cannot flood the log with one bad window.
+ */
+static void riscv32_report_read_disagreement(
+	const target_addr64_t src, const uint8_t *const first, const uint8_t *const second, const size_t len)
+{
+	size_t differing = 0;
+	bool recorded = false;
+	for (size_t element = 0; element < len; element += RV_READ_CONFIRM_ELEMENT) {
+		uint32_t a = 0;
+		uint32_t b = 0;
+		const size_t element_len =
+			len - element < RV_READ_CONFIRM_ELEMENT ? len - element : RV_READ_CONFIRM_ELEMENT;
+		if (!memcmp(first + element, second + element, element_len))
+			continue;
+		memcpy(&a, first + element, element_len);
+		memcpy(&b, second + element, element_len);
+		if (!recorded) {
+			recorded = true;
+			riscv_confirm_stats.last_address = (uint32_t)(src + element);
+			riscv_confirm_stats.last_first_pass = a;
+			riscv_confirm_stats.last_second_pass = b;
+		}
+		if (differing < 4U)
+			RV_MEMLOG("riscv: read @ %08" PRIx32 ": pass 1 said %08" PRIx32 ", pass 2 said %08" PRIx32 "\n",
+				(uint32_t)(src + element), a, b);
+		++differing;
+	}
+	RV_MEMLOG("riscv: read @ %08" PRIx32 " len %zu: the two passes disagreed on %zu element(s)\n", (uint32_t)src,
+		len, differing);
+}
+
+/*
+ * BMP 103: the confirmed read, scoped to a transport that cannot report a lost access.
+ *
+ * The debug module answers a read that never happened with the *previous* answer while `busy`
+ * and `cmderr` both stay clear, so no status bit a caller can poll reports the window and patch
+ * 102 - which re-issues what a path *reports* - can never fire on one. Nothing in the DM says
+ * "this access ran", so an element is confirmed the way the silicon tests validated it: read it
+ * again and compare. This is patch 98's scheme; the difference is that it is selected by the
+ * transport (dmi_bus->read_confirm) instead of being imposed on every RISC-V part, where it
+ * doubles the read traffic of silicon that does not have the defect.
+ *
+ * A window is read twice. A window whose two passes agree is settled. When they disagree the
+ * elements they disagree about are settled one at a time - an element read twice either agrees,
+ * or its third read is the right one (T11 of ch32v0x_silicon_tests) - so a dropped block costs
+ * a few accesses instead of a second pass over the whole window.
+ */
+static void riscv32_mem_read_confirmed(
+	riscv_hart_s *const hart, void *const dest, const target_addr64_t src, const size_t len)
+{
+	/* Not `data`: the DEBUG_PROTO block in the caller declares one of those */
+	uint8_t *const buf = (uint8_t *)dest;
+	for (size_t offset = 0; offset < len; offset += RV_READ_CONFIRM_WINDOW) {
+		const size_t window = len - offset < RV_READ_CONFIRM_WINDOW ? len - offset : RV_READ_CONFIRM_WINDOW;
+		uint8_t *const window_data = buf + offset;
+		const target_addr64_t window_src = src + offset;
+		uint8_t retry[RV_READ_CONFIRM_WINDOW] = {0};
+		bool settled = false;
+		bool have_two_passes = false;
+
+		riscv_confirm_stats.windows++;
+		/*
+		 * A window is good once a pass ran clean and a second pass agreed with it. A fault is
+		 * not fatal in itself - riscv32_mem_read_once() has already dropped the command error
+		 * the module was left with, so the window can simply be asked for again - and only a
+		 * window that never settles carries the fault on to the caller, which is what a real
+		 * bus error does.
+		 */
+		for (size_t attempt = 0; attempt < RV_READ_CONFIRM_TRIES && !settled; ++attempt) {
+			if (!riscv32_mem_read_once(hart, window_data, window_src, window))
+				continue;
+			if (!riscv32_mem_read_once(hart, retry, window_src, window))
+				continue;
+			have_two_passes = true;
+			settled = !memcmp(window_data, retry, window);
+		}
+		if (settled)
+			continue;
+		/*
+		 * The two passes disagree. Name the difference on the log, keep the newest answer for
+		 * the elements that never settle, and settle the rest one element at a time.
+		 */
+		riscv_confirm_stats.disagreeing++;
+		riscv_confirm_stats.last_address = (uint32_t)window_src;
+		riscv_confirm_stats.last_first_pass = 0;
+		riscv_confirm_stats.last_second_pass = 0;
+		if (have_two_passes)
+			riscv32_report_read_disagreement(window_src, window_data, retry, window);
+		for (size_t element = 0; element < window; element += RV_READ_CONFIRM_ELEMENT) {
+			const size_t element_len =
+				window - element < RV_READ_CONFIRM_ELEMENT ? window - element : RV_READ_CONFIRM_ELEMENT;
+			uint8_t *const element_data = window_data + element;
+			/* Both passes agree on this element: it is settled */
+			if (have_two_passes && !memcmp(element_data, retry + element, element_len))
+				continue;
+			const target_addr64_t element_src = window_src + element;
+			uint8_t element_buf[RV_READ_CONFIRM_ELEMENT];
+			riscv_confirm_stats.elements++;
+			for (size_t pass = 0; pass < RV_READ_CONFIRM_TRIES; ++pass) {
+				if (!riscv32_mem_read_once(hart, element_buf, element_src, element_len))
+					continue;
+				/* Two reads of the element agree: it is settled */
+				if (!memcmp(element_data, element_buf, element_len))
+					break;
+				/* They disagree: keep the re-issued answer, which T11 measured as the good one */
+				memcpy(element_data, element_buf, element_len);
+			}
+		}
+	}
+}
