+/* Try to read memory from the target without halting the CPU. Returns true if the
+ * read was performed, false if the target cannot do non-halting memory I/O. */
+bool target_mem_read_nostop(target_s *const target, void *const dest, const target_addr64_t src, const size_t len)
+{
+	if (target->mem_read_nostop)
+		return target->mem_read_nostop(target, dest, src, len);
+	/*
+	 * No explicit non-halting hook. If the target advertises non-halting memory
+	 * I/O (TOPT_NON_HALTING_MEM_IO, eg. Cortex-M), its generic mem_read is safe
+	 * to call while the CPU keeps running, so use it.
+	 */
+	if (target->target_options & TOPT_NON_HALTING_MEM_IO) {
+		if (target->mem_read)
+			target->mem_read(target, dest, src, len);
+		return true;
+	}
+	return false;
+}
+
+/* Try to write memory to the target without halting the CPU. Returns true if the
+ * write was performed, false if the target cannot do non-halting memory I/O. */
+bool target_mem_write_nostop(target_s *const target, const target_addr64_t dest, const void *const src, const size_t len)
+{
+	if (target->mem_write_nostop)
+		return target->mem_write_nostop(target, dest, src, len);
+	/* Same TOPT fallback as target_mem_read_nostop above */
+	if (target->target_options & TOPT_NON_HALTING_MEM_IO) {
+		if (target->mem_write)
+			target->mem_write(target, dest, src, len);
+		return true;
+	}
+	return false;
+}
