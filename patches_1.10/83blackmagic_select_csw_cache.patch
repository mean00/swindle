 /* The following enum is based on the Component Class value table 13-3 of the ADIv5 specification. */
diff --git a/src/target/adiv5_interface.h b/src/target/adiv5_interface.h
index 6994bd5..b506193 100644
--- a/src/target/adiv5_interface.h
+++ b/src/target/adiv5_interface.h
@@ -68,6 +68,12 @@ static inline void adiv5_dp_write(adiv5_debug_port_s *const dp, const uint16_t a
 	decode_access(addr, ADIV5_LOW_WRITE, 0U, value);
 	DEBUG_PROTO("0x%08" PRIx32 "\n", value);
 #endif
+	/* Keep the DP-SELECT shadow register in sync so AP accesses can skip
+	 * redundant SELECT writes (BMP 83). */
+	if (addr == ADIV5_DP_SELECT) {
+		dp->select_cache = value;
+		dp->select_cached = 1;
+	}
 	dp->low_access(dp, ADIV5_LOW_WRITE, addr, value);
 }
 
diff --git a/src/target/adiv5.h b/src/target/adiv5.h
index ab8f24f..c5b7f98 100644
--- a/src/target/adiv5.h
+++ b/src/target/adiv5.h
@@ -277,6 +277,9 @@ void adiv5_mem_read_bytes(adiv5_access_port_s *ap, void *dest, target_addr64_t s
 /* ADIv5 logical operation functions for AP register I/O */
 void adiv5_ap_reg_write(adiv5_access_port_s *ap, uint16_t addr, uint32_t value);
 uint32_t adiv5_ap_reg_read(adiv5_access_port_s *ap, uint16_t addr);
+/* Write DP-SELECT for the given AP register bank, skipping the write when the
+ * last written value is unchanged (BMP 83). */
+void adiv5_ap_select(adiv5_access_port_s *ap, uint16_t addr);
 
 /* ADIv5 DP logical operation function for reading DPIDR safely */
 uint32_t adiv5_dp_read_dpidr(adiv5_debug_port_s *dp);
diff --git a/src/target/adiv5.c b/src/target/adiv5.c
index 7b254df..7454b55 100644
--- a/src/target/adiv5.c
+++ b/src/target/adiv5.c
@@ -694,17 +694,33 @@ void adiv5_mem_write_bytes(
 	adiv5_dp_read(ap->dp, ADIV5_DP_RDBUFF);
 }
 
+/* Write DP-SELECT for the given AP register bank, skipping the transaction when
+ * nothing changed. The shadow register is kept in sync on every SELECT write,
+ * both here and in adiv5_dp_write(), so a skip is only ever done when the DP's
+ * SELECT register already holds the requested value (BMP 83). */
+void adiv5_ap_select(adiv5_access_port_s *const ap, const uint16_t addr)
+{
+	const uint32_t select = ((uint32_t)ap->apsel << 24U) | (addr & 0xf0U);
+	if (select != ap->dp->select_cache || !ap->dp->select_cached) {
+		adiv5_dp_recoverable_access(ap->dp, ADIV5_LOW_WRITE, ADIV5_DP_SELECT, select);
+		ap->dp->select_cache = select;
+		ap->dp->select_cached = 1;
+	}
+}
+
 void adiv5_ap_reg_write(adiv5_access_port_s *ap, uint16_t addr, uint32_t value)
 {
-	adiv5_dp_recoverable_access(
-		ap->dp, ADIV5_LOW_WRITE, ADIV5_DP_SELECT, ((uint32_t)ap->apsel << 24U) | (addr & 0xf0U));
+	adiv5_ap_select(ap, addr);
 	adiv5_dp_write(ap->dp, addr, value);
+	if (addr == ADIV5_AP_CSW) {
+		ap->csw_cache = value;
+		ap->csw_cached = 1;
+	}
 }
 
 uint32_t adiv5_ap_reg_read(adiv5_access_port_s *ap, uint16_t addr)
 {
-	adiv5_dp_recoverable_access(
-		ap->dp, ADIV5_LOW_WRITE, ADIV5_DP_SELECT, ((uint32_t)ap->apsel << 24U) | (addr & 0xf0U));
+	adiv5_ap_select(ap, addr);
 	return adiv5_dp_read(ap->dp, addr);
 }
 
diff --git a/src/target/adi.c b/src/target/adi.c
index 469dec7..d4196d4 100644
--- a/src/target/adi.c
+++ b/src/target/adi.c
@@ -535,8 +535,13 @@ void adi_ap_mem_access_setup(adiv5_access_port_s *const ap, const target_addr64_
 		csw |= ADIV5_AP_CSW_SIZE_WORD;
 		break;
 	}
-	/* Select AP bank 0 and write CSW */
-	adiv5_ap_write(ap, ADIV5_AP_CSW, csw);
+	/* Select AP bank 0 and write CSW, skipping the CSW write when nothing changed
+	 * (BMP 83). The SELECT write itself is also skipped when the bank is already
+	 * selected, so warm accesses pay only TAR + data. */
+	if (ap->csw_cached && ap->csw_cache == csw)
+		adiv5_ap_select(ap, ADIV5_AP_CSW);
+	else
+		adiv5_ap_write(ap, ADIV5_AP_CSW, csw);
 	/* Then write TAR which is in the same AP bank */
 	if (ap->flags & ADIV5_AP_FLAGS_64BIT)
 		adiv5_dp_write(ap->dp, ADIV5_AP_TAR_HIGH, (uint32_t)(addr >> 32U));
