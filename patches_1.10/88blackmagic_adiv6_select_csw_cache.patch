@@ -382,6 +382,8 @@
 	 * registers to their reset values (BMP 83). */
 	dp->select_cache = 0;
 	dp->select_cached = 0;
+	dp->select1_cache = 0;
+	dp->select1_cached = 0;
 	dp->ap_write = adiv5_ap_reg_write;
 	dp->ap_read = adiv5_ap_reg_read;
 	dp->mem_read = adiv5_mem_read_bytes;
@@ -727,6 +729,34 @@
  * SELECT register already holds the requested value (BMP 83). */
 void adiv5_ap_select(adiv5_access_port_s *const ap, const uint16_t addr)
 {
+	if (ap->dp->version >= 3U) {
+		/*
+		 * ADIv6: the AP is selected with SELECT1 (upper 32 bits of the AP's
+		 * bus address) plus SELECT (lower 32 bits | register bank). SELECT1 is
+		 * only reachable while DP-SELECT is on bank 5, so hop there only when
+		 * the upper address actually needs rewriting. Both writes are skipped
+		 * entirely when nothing has changed (BMP 88).
+		 */
+		adiv6_access_port_s *const ap6 = (adiv6_access_port_s *)ap;
+		const uint32_t select1 = (uint32_t)(ap6->ap_address >> 32U);
+		if (select1 != ap->dp->select1_cache || !ap->dp->select1_cached) {
+			if (ap->dp->select_cache != ADIV5_DP_BANK5 || !ap->dp->select_cached) {
+				adiv5_dp_recoverable_access(ap->dp, ADIV5_LOW_WRITE, ADIV5_DP_SELECT, ADIV5_DP_BANK5);
+				ap->dp->select_cache = ADIV5_DP_BANK5;
+				ap->dp->select_cached = 1;
+			}
+			adiv5_dp_recoverable_access(ap->dp, ADIV5_LOW_WRITE, ADIV6_DP_SELECT1, select1);
+			ap->dp->select1_cache = select1;
+			ap->dp->select1_cached = 1;
+		}
+		const uint32_t select = (uint32_t)ap6->ap_address | (addr & ADIV6_AP_BANK_MASK);
+		if (select != ap->dp->select_cache || !ap->dp->select_cached) {
+			adiv5_dp_recoverable_access(ap->dp, ADIV5_LOW_WRITE, ADIV5_DP_SELECT, select);
+			ap->dp->select_cache = select;
+			ap->dp->select_cached = 1;
+		}
+		return;
+	}
 	const uint32_t select = ((uint32_t)ap->apsel << 24U) | (addr & 0xf0U);
 	if (select != ap->dp->select_cache || !ap->dp->select_cached) {
 		adiv5_dp_recoverable_access(ap->dp, ADIV5_LOW_WRITE, ADIV5_DP_SELECT, select);
@@ -742,6 +772,7 @@
 void adiv5_ap_invalidate_caches(adiv5_access_port_s *const ap)
 {
 	ap->dp->select_cached = 0;
+	ap->dp->select1_cached = 0;
 	ap->csw_cached = 0;
 }
 
