+/*
+ * BMP 96: wait for the system bus to go idle. sbdata0 carries the result of an access only
+ * once that access has completed; taken earlier, the read answers with the value of the access
+ * the read itself triggers, which is one access unit above the address that was asked for.
+ * That is what a CH32V006 was measured doing -- a 32-bit read answering the word above, an
+ * 8-bit read the byte above, on flash reads only (the slow accesses) and never on RAM, with a
+ * verified reread always coming back right (ch32v0x_silicon_tests/08_read_path_check_v006.gdb,
+ * T10/T12).
+ */
+static bool riscv32_sysbus_wait_idle(riscv_hart_s *const hart)
+{
+	for (size_t spin = 0; spin < RV_SYSBUS_IDLE_SPINS; ++spin) {
+		uint32_t status = 0;
+		if (!riscv_dm_read(hart->dbg_module, RV_DM_SYSBUS_CTRLSTATUS, &status))
+			return false;
+		if (!(status & RV_SYSBUS_STATUS_SBBUSY))
+			return true;
+	}
+	/* The bus never reported itself idle: hand back to the caller instead of hanging here,
+	 * and let riscv_sysbus_check() report the state the debug module is left in. */
+	return true;
+}
+
+/*
+ * BMP 96: program the access control register, and only then write the address register that
+ * triggers the access. A command write that the DM drops while it is still busy leaves the
+ * previous request's autoincrement and read-on-data bits armed, and the access that follows is
+ * then answered one access unit above the address it asked for. So for a request that does not
+ * want those bits, read the state back until the DM shows them clear before anything triggers.
+ */
+static bool riscv32_sysbus_program(
+	riscv_hart_s *const hart, const uint32_t command, const target_addr_t src)
+{
+	const uint32_t must_be_clear = RV_SYSBUS_ARMED_BITS & ~command;
+	if (must_be_clear) {
+		for (size_t attempt = 0; attempt < RV_SYSBUS_PROGRAM_TRIES; ++attempt) {
+			uint32_t readback = 0;
+			if (!riscv_dm_write(hart->dbg_module, RV_DM_SYSBUS_CTRLSTATUS, command))
+				return false;
+			if (!riscv_dm_read(hart->dbg_module, RV_DM_SYSBUS_CTRLSTATUS, &readback))
+				return false;
+			if (!(readback & must_be_clear))
+				break;
+		}
+	} else if (!riscv_dm_write(hart->dbg_module, RV_DM_SYSBUS_CTRLSTATUS, command))
+		return false;
+	/* Only now trigger the access */
+	return riscv_dm_write(hart->dbg_module, RV_DM_SYSBUS_ADDR0, src);
+}
