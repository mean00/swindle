--- a/src/target/riscv_debug.h
+++ b/src/target/riscv_debug.h
@@ -222,6 +222,18 @@
 #define RV_SYSBUS_MEM_READ_ON_DATA  0x00008000U
 #define RV_SYSBUS_STATUS_BUSY       0x00200000U
 #define RV_SYSBUS_MEM_ACCESS_SHIFT  17U
+/* sbcs.sbbusy (bit 22): set while a system bus access is in progress. sbdata0 only holds the
+ * result of an access once that access has completed, so this is the bit that has to be seen
+ * clear before the data is taken (BMP 96). */
+#define RV_SYSBUS_STATUS_SBBUSY 0x00400000U
+/* The bits that make an access run ahead of itself: autoincrement moves the address on, and
+ * read-on-data makes every sbdata0 read trigger -- and answer -- a further access. A request
+ * that does not ask for them must not find them armed. */
+#define RV_SYSBUS_ARMED_BITS (RV_SYSBUS_MEM_ADDR_POST_INC | RV_SYSBUS_MEM_READ_ON_DATA)
+/* Handshake bounds: long enough to cover a slow (flash) access, short enough to hand back to
+ * the caller when the debug module is wedged instead of hanging the probe. */
+#define RV_SYSBUS_IDLE_SPINS    10000U
+#define RV_SYSBUS_PROGRAM_TRIES 8U
 
 /* dpc -> Debug Program Counter */
 #define RV_DPC 0x7b1U
