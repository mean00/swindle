+/*
+ * BMP 100: dpc preservation around program buffer execution (RISC-V Debug spec 3.7).
+ *
+ * "Executing the Program Buffer may clobber dpc. If that is the case, it must be possible to
+ * read/write dpc using an abstract command with postexec not set. The debugger must attempt to
+ * save dpc between halting and executing a Program Buffer, and then restore dpc before leaving
+ * Debug Mode."
+ *
+ * The save therefore has to be an abstract command carrying dpc itself in its register transfer
+ * and with no program buffer of its own - anything that ran a program buffer to fetch dpc would
+ * be running the very thing that clobbers it, and would read the clobbered value instead. It is
+ * tried at the width the Hart was probed with and then at half that, so a Debug Module that only
+ * implements 32-bit transfers (the V003 answers cmderr = 2 to a wider one) is still handled.
+ *
+ * Paying for that around every program buffer execution would be pure loss on a part that does
+ * not clobber dpc, so the first execution measures it: the value after the execution is compared
+ * with the value before it, and the Hart is made to pay from then on only if they differ. That
+ * measurement is also what says on the probe's log which kind of part this is.
+ */
+static bool riscv_dpc_read(riscv_hart_s *const hart, uint32_t dpc[RV_DPC_WORDS])
+{
+	/* Looking at dpc is not the caller's verdict on the Hart: leave the status as it was */
+	const riscv_hart_status_e status = hart->status;
+	for (uint8_t width = hart->access_width; width >= 32U; width >>= 1U) {
+		if (riscv_dm_write(hart->dbg_module, RV_DM_ABST_COMMAND,
+				RV_DM_ABST_CMD_ACCESS_REG | RV_ABST_READ | RV_REG_XFER | riscv_hart_access_width(width) |
+					RV_DPC) &&
+			riscv_command_wait_complete(hart) && riscv_csr_read_data(hart, dpc, width)) {
+			hart->status = status;
+			return true;
+		}
+	}
+	hart->status = status;
+	return false;
+}
+
+static bool riscv_dpc_write(riscv_hart_s *const hart, const uint32_t dpc[RV_DPC_WORDS])
+{
+	/* As above: putting dpc back is not the caller's verdict on the Hart either */
+	const riscv_hart_status_e status = hart->status;
+	for (uint8_t width = hart->access_width; width >= 32U; width >>= 1U) {
+		if (riscv_csr_write_data(hart, dpc, width) &&
+			riscv_dm_write(hart->dbg_module, RV_DM_ABST_COMMAND,
+				RV_DM_ABST_CMD_ACCESS_REG | RV_ABST_WRITE | RV_REG_XFER | riscv_hart_access_width(width) |
+					RV_DPC) &&
+			riscv_command_wait_complete(hart)) {
+			hart->status = status;
+			return true;
+		}
+	}
+	hart->status = status;
+	return false;
+}
+
+/*
+ * BMP 100: called before a program buffer run. Returns true if dpc was saved and the matching
+ * riscv_dpc_guard_end() has to be called, false if this Hart needs nothing done - or cannot have
+ * anything done, which has been reported on the probe's log by then.
+ */
+bool riscv_dpc_guard_begin(riscv_hart_s *const hart, uint32_t dpc[RV_DPC_WORDS])
+{
+	if (hart->dpc_guard == RV_DPC_GUARD_OPAQUE)
+		return false;
+	/*
+	 * An execution that did not complete cleanly (a bus error or an exception inside the program
+	 * buffer) can move dpc even where a clean one does not, so stop trusting the measurement.
+	 */
+	if (hart->dpc_guard == RV_DPC_GUARD_STABLE && hart->status == RISCV_HART_NO_ERROR)
+		return false;
+	if (!riscv_dpc_read(hart, dpc)) {
+		hart->dpc_guard = RV_DPC_GUARD_OPAQUE;
+		DEBUG_WARN("riscv: dpc cannot be read without running the program buffer, so it cannot be "
+				   "protected across program buffer execution\n");
+		return false;
+	}
+	return true;
+}
+
+/*
+ * BMP 100: called after a program buffer run started by the matching riscv_dpc_guard_begin().
+ * Returns false if dpc is no longer known to hold what it did before the run.
+ */
+bool riscv_dpc_guard_end(riscv_hart_s *const hart, const uint32_t dpc[RV_DPC_WORDS])
+{
+	/* Already known to clobber dpc: put the saved value back without paying for another read */
+	if (hart->dpc_guard == RV_DPC_GUARD_CLOBBERS) {
+		if (!riscv_dpc_write(hart, dpc)) {
+			hart->dpc_guard = RV_DPC_GUARD_OPAQUE;
+			DEBUG_WARN("riscv: dpc could not be restored, the Hart's program counter is now wrong\n");
+			return false;
+		}
+		return true;
+	}
+	uint32_t now[RV_DPC_WORDS] = {0U};
+	if (!riscv_dpc_read(hart, now)) {
+		hart->dpc_guard = RV_DPC_GUARD_OPAQUE;
+		DEBUG_WARN("riscv: dpc cannot be read back after program buffer execution, so it can no "
+				   "longer be protected\n");
+		return false;
+	}
+	if (now[0] == dpc[0]) {
+		hart->dpc_guard = RV_DPC_GUARD_STABLE;
+		DEBUG_INFO("riscv: dpc survives program buffer execution on this part, no longer saving it\n");
+		return true;
+	}
+	hart->dpc_guard = RV_DPC_GUARD_CLOBBERS;
+	DEBUG_WARN("riscv: program buffer execution clobbers dpc (%08" PRIx32 " -> %08" PRIx32 "), it is now "
+			   "saved and restored around every execution\n",
+		dpc[0], now[0]);
+	if (!riscv_dpc_write(hart, dpc)) {
+		hart->dpc_guard = RV_DPC_GUARD_OPAQUE;
+		DEBUG_WARN("riscv: dpc could not be restored, the Hart's program counter is now wrong\n");
+		return false;
+	}
+	return true;
+}
+
