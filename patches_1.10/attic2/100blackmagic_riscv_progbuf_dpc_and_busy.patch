+/* How many times a bounce register is put back after a program buffer run before giving up */
+#define RISCV_PROGBUF_RESTORE_TRIES 2U
+
+/*
+ * BMP 100: put a GPR back the way a program buffer run found it, and make sure it landed.
+ *
+ * The DMI link drops the odd write (the Debug Module answers the access but the transfer never
+ * lands - the ch006 investigation in ch32v0x_silicon_tests is that happening during reads), and a
+ * write issued while an abstract command is still executing is discarded by the Debug Module
+ * (spec 3.12.7), so a restore can be lost with nothing to show for it: a0 is then left holding
+ * the advanced address (one addi a0, a0, 4 per executed program) and a1 the last word the program
+ * transferred. The write is therefore verified by reading the register back, and retried a bounded
+ * number of times. Only the low word is compared: the upper half of a transfer wider than the Hart
+ * is not defined by the spec, while on a 32-bit Hart the low word is the whole register.
+ */
+static bool riscv32_progbuf_restore_gpr(
+	riscv_hart_s *const hart, const uint16_t reg, const uint32_t value[RV_DPC_WORDS])
+{
+	for (uint32_t attempt = 0; attempt < RISCV_PROGBUF_RESTORE_TRIES; ++attempt) {
+		uint32_t readback[RV_DPC_WORDS] = {0U};
+		if (riscv_csr_write(hart, reg, value) && riscv_csr_read(hart, reg, readback) &&
+			readback[0] == value[0])
+			return true;
+	}
+	DEBUG_WARN("riscv: GPR %04x could not be put back after program buffer execution (%08" PRIx32 ")\n", reg,
+		value[0]);
+	return false;
+}
+
+/*
+ * BMP 100: a register write that must not race the abstract command an autoexec'd data0 access has
+ * just started. Touching command, abstractauto, progbuf or the data registers while a command is
+ * executing sets cmderr to 1 and the access is discarded - "Attempts to write them while busy is
+ * set does not change their value" (spec 3.12.7, 3.12.8, 3.12.11, 3.12.12; the vendor documents
+ * the same rule at sdi.txt:1258), which is exactly how a register restore, or the write that drops
+ * the autoexec stream, can go missing. riscv_command_wait_complete() waits for busy to clear *and*
+ * consumes cmderr, so it is used to quiesce the pipeline first. The write is attempted even if that
+ * did not work out: a write the Debug Module rejects is ignored, while leaving the autoexec stream
+ * armed would re-run a stale command on the next data0 access - i.e. during the restores.
+ */
+static bool riscv32_progbuf_quiesced_write(riscv_hart_s *const hart, const uint8_t address, const uint32_t value)
+{
+	const bool quiesced = riscv_command_wait_complete(hart);
+	return riscv_dm_write(hart->dbg_module, address, value) && quiesced;
+}
