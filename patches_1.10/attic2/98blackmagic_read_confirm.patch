+/*
+ * BMP 98: confirmed reads.
+ *
+ * The debug module on these parts sometimes answers a read with the result of the
+ * transfer before it -- the command, or the DATA0 write behind the access, never
+ * landed -- while both `busy` and `cmderr` stay clear. No status bit a caller can
+ * poll reports the window, so the caller is handed the previous answer instead,
+ * which shows up as a word repeated that the request never asked for (measured as
+ * "case 5" of ch32v0x_silicon_tests/investigate_ch006.md, 36 repeated answers in
+ * one run 6 pass).
+ *
+ * Since nothing in the DM reports "this access ran", the element is confirmed the
+ * way the silicon tests validated: read it a second time and compare. Two passes
+ * that agree settle the element; when they disagree the element is re-issued
+ * (bounded) and the newest answer stands, which is what a single dropped transfer
+ * needs -- T11 measured the first pair bad and the third read right. Confirming a
+ * window with a second pass keeps a stalled transfer from costing the whole
+ * transfer and keeps the scratch buffer small; a window whose two passes disagree
+ * is then settled one element at a time, so an element that went wrong on its own
+ * is repaired as well.
+ *
+ * A dropped transfer can also fault instead of answering late, and a fault is not
+ * fatal either: the module is left either with a set command error -- which makes
+ * it ignore every command after it, so one dropped clear of that error turns into a
+ * whole section that faults -- or with an unreached address to blame. Both are
+ * recovered here by asking for the transfer again (bounded), and only a window that
+ * never settles passes the fault on to the caller.
+ */
+#define RV_READ_CONFIRM_WINDOW 128U
+#define RV_READ_CONFIRM_ELEMENT 4U /* the native RISC-V access unit, T11's confirmation granularity */
+#define RV_READ_CONFIRM_RETRIES 3U
+
+/*
+ * A dropped transfer does not only answer late: it can also leave the module with a set command
+ * error, which makes it ignore every command after it. `riscv_command_wait_complete` asks for
+ * that error to be cleared by a write, and writes are subject to the same defect, so the clear is
+ * asked for again until the module agrees it took; reading the register back is what tells the
+ * two apart -- a clear that landed, or a status that stays set and is then left for the caller.
+ */
+static void riscv32_clear_command_error(riscv_hart_s *const hart)
+{
+	for (size_t attempt = 0; attempt < RV_READ_CONFIRM_RETRIES; ++attempt) {
+		uint32_t status = 0;
+		if (!riscv_dm_write(hart->dbg_module, RV_DM_ABST_CTRLSTATUS, RISCV_HART_OTHER << 8U))
+			return;
+		if (!riscv_dm_read(hart->dbg_module, RV_DM_ABST_CTRLSTATUS, &status))
+			return;
+		if (!(status & (RISCV_HART_OTHER << 8U))) {
+			hart->status = RISCV_HART_NO_ERROR;
+			return;
+		}
+	}
+}
+
+/*
+ * One unconfirmed pass over a request, using whichever method this hart routes to.
+ * Returns false if the pass faulted, having left the module able to be asked again.
+ */
+static bool riscv32_mem_read_once(
+	riscv_hart_s *const hart, void *const dest, const target_addr64_t src, const size_t len)
+{
+	if (hart->flags & RV_HART_FLAG_MEMORY_SYSBUS) {
+		riscv32_sysbus_mem_read(hart, dest, (target_addr_t)src, len);
+		/* 85: a system-bus fault is recorded in the module's control/status, not in cmderr */
+		riscv_sysbus_check(hart);
+		return hart->status == RISCV_HART_NO_ERROR;
+	}
+
+	if (hart->flags & RV_HART_FLAG_MEMORY_PROGBUF)
+		riscv32_progbuf_mem_read(hart, dest, src, len);
+	else
+		riscv32_abstract_mem_read(hart, dest, src, len);
+	if (hart->status == RISCV_HART_NO_ERROR)
+		return true;
+	riscv32_clear_command_error(hart);
+	return false;
+}
+
