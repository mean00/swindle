+	/* BMP 98: read window by window, and only trust a window two passes agree on */
+	for (size_t offset = 0; offset < len; offset += RV_READ_CONFIRM_WINDOW) {
+		const size_t window = len - offset < RV_READ_CONFIRM_WINDOW ? len - offset : RV_READ_CONFIRM_WINDOW;
+		uint8_t *const window_data = buf + offset;
+		const target_addr64_t window_src = src + offset;
+		uint8_t retry[RV_READ_CONFIRM_WINDOW] = {0};
+		bool settled = false;
+		bool have_two_passes = false;
+
+		/*
+		 * A window is good once a pass has run without a fault and a second pass agrees with
+		 * it. A fault is not fatal in itself: a transfer that reached an address it should not
+		 * have (or left the command error set) is asked for again, and only a window that never
+		 * settles carries the fault on to the caller -- which is what a real bus error does.
+		 */
+		for (size_t attempt = 0; attempt < RV_READ_CONFIRM_RETRIES && !settled; ++attempt) {
+			if (!riscv32_mem_read_once(hart, window_data, window_src, window))
+				continue;
+			if (!riscv32_mem_read_once(hart, retry, window_src, window))
+				continue;
+			have_two_passes = true;
+			settled = !memcmp(window_data, retry, window);
+		}
+		if (settled)
