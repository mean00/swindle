+		for (size_t element = 0; element < window; element += RV_READ_CONFIRM_ELEMENT) {
+			const size_t element_len =
+				window - element < RV_READ_CONFIRM_ELEMENT ? window - element : RV_READ_CONFIRM_ELEMENT;
+			uint8_t *const element_data = window_data + element;
+			/* Both passes agree on this element: it is settled */
+			if (have_two_passes && !memcmp(element_data, retry + element, element_len))
+				continue;
+			const target_addr64_t element_src = window_src + element;
+			uint8_t element_buf[RV_READ_CONFIRM_ELEMENT];
+			for (size_t pass = 0; pass < RV_READ_CONFIRM_RETRIES; ++pass) {
+				if (!riscv32_mem_read_once(hart, element_buf, element_src, element_len))
+					continue;
+				/* Two reads of the element agree: it is settled */
+				if (!memcmp(element_data, element_buf, element_len))
+					break;
+				/* They disagree: keep the re-issued answer, which T11 measured as the good one */
+				memcpy(element_data, element_buf, element_len);
+			}
+		}
+	}
 
