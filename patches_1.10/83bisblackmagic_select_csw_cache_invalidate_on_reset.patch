diff --git a/src/target/adiv5.c b/src/target/adiv5.c
index 7b254df2..5f608222 100644
--- a/src/target/adiv5.c
+++ b/src/target/adiv5.c
@@ -198,6 +198,9 @@ static bool cortexm_prepare(adiv5_access_port_s *ap)
 	platform_timeout_set(&reset_timeout, cortexm_wait_timeout);
 	/* Deassert the physical reset line */
 	platform_nrst_set_val(false);
+	/* Releasing the core from reset may have reset the debug domain: drop the
+	 * SELECT/CSW write caches built up during probing (BMP 83). */
+	adiv5_ap_invalidate_caches(ap);
 	while (true) {
 		/* Read back DHCSR and check if the reset status bit is still set */
 		dhcsr = adi_mem_read32(ap, CORTEXM_DHCSR);
@@ -369,6 +372,12 @@ void adiv5_dp_init(adiv5_debug_port_s *const dp)
 	 * We have to initialise the DP routines up front before any adiv5_* functions are called or
 	 * bad things happen under BMDA (particularly CMSIS-DAP)
 	 */
+	/* Drop the SELECT/CSW write caches: the DP may have been re-initialized
+	 * after a target reset or power cycle (or cloned from another DP in
+	 * multi-drop), which would have reverted DP-SELECT and the AP CSW
+	 * registers to their reset values (BMP 83). */
+	dp->select_cache = 0;
+	dp->select_cached = 0;
 	dp->ap_write = adiv5_ap_reg_write;
 	dp->ap_read = adiv5_ap_reg_read;
 	dp->mem_read = adiv5_mem_read_bytes;
@@ -694,17 +703,43 @@ void adiv5_mem_write_bytes(
 	adiv5_dp_read(ap->dp, ADIV5_DP_RDBUFF);
 }
 
+/* Write DP-SELECT for the given AP register bank, skipping the transaction when
+ * nothing changed. The shadow register is kept in sync on every SELECT write,
+ * both here and in adiv5_dp_write(), so a skip is only ever done when the DP's
+ * SELECT register already holds the requested value (BMP 83). */
+void adiv5_ap_select(adiv5_access_port_s *const ap, const uint16_t addr)
+{
+	const uint32_t select = ((uint32_t)ap->apsel << 24U) | (addr & 0xf0U);
+	if (select != ap->dp->select_cache || !ap->dp->select_cached) {
+		adiv5_dp_recoverable_access(ap->dp, ADIV5_LOW_WRITE, ADIV5_DP_SELECT, select);
+		ap->dp->select_cache = select;
+		ap->dp->select_cached = 1;
+	}
+}
+
+/* Clear the DP-SELECT/AP-CSW write caches after an event that may have reset the
+ * debug domain (nRST, power cycle, ...). The shadow caches still claim to hold
+ * the last written values, but the real registers have reverted to their reset
+ * values, so the next access re-writes SELECT and CSW unconditionally (BMP 83). */
+void adiv5_ap_invalidate_caches(adiv5_access_port_s *const ap)
+{
+	ap->dp->select_cached = 0;
+	ap->csw_cached = 0;
+}
+
 void adiv5_ap_reg_write(adiv5_access_port_s *ap, uint16_t addr, uint32_t value)
 {
-	adiv5_dp_recoverable_access(
-		ap->dp, ADIV5_LOW_WRITE, ADIV5_DP_SELECT, ((uint32_t)ap->apsel << 24U) | (addr & 0xf0U));
+	adiv5_ap_select(ap, addr);
 	adiv5_dp_write(ap->dp, addr, value);
+	if (addr == ADIV5_AP_CSW) {
+		ap->csw_cache = value;
+		ap->csw_cached = 1;
+	}
 }
 
 uint32_t adiv5_ap_reg_read(adiv5_access_port_s *ap, uint16_t addr)
 {
-	adiv5_dp_recoverable_access(
-		ap->dp, ADIV5_LOW_WRITE, ADIV5_DP_SELECT, ((uint32_t)ap->apsel << 24U) | (addr & 0xf0U));
+	adiv5_ap_select(ap, addr);
 	return adiv5_dp_read(ap->dp, addr);
 }
 
