# 112blackmagic_target_flash_merged.patch
#
# WHY THIS PATCH EXISTS
# ---------------------
# Consolidates Target common, flash subsystem, breakpoint framework, and architecture options
# across shared headers (formerly patches 47, 50, 51, 55, and common parts of 82bis, 85bis, 105):
#
# Note: src/target/target.c and src/target/target_flash.c are omitted because they are not compiled
# into the build (replaced by rs_swindle and bmp_helpers.cpp).
#
# 1. Target Architecture & Option Tracking (formerly patch 82bis, 47):
#    Blackmagic needed a clean, unified way to tag target architectures (ARM vs RISC-V) in
#    target->target_options using bitfields (TOP_ARCH_SHIFT) so higher-level debug code can
#    determine the architecture without fragile string comparisons on target->driver.
#
# 2. Software Breakpoint Framework & Query Helpers (formerly patches 50, 51):
#    Provides generic target hooks for software breakpoints (sw_breakpoint_helpers)
#    and exports target_breakpoint_watchpoint_count / target_has_hw_breakpoint helpers.
#
# 3. Flash Variable Block Erase Size Definition (formerly patch 55):
#    Adds optional erasesizes array to target_flash struct for multi-size erase support.
#
# 4. Non-Halting Memory Access Declarations:
#    Declares target_mem_read_nostop and target_mem_write_nostop hooks in target.h and target_internal.h.
#
# 5. Target Probe Wrapper:
#    Wraps PROBE(x) macro in target_probe.h to call bmp_tweak_options().
#
# FIX
# ---
# 1. In src/include/target.h:
#    - Define TOPT_GET_ARCH, TOPT_SET_ARCH, TOPT_ARCH_ARM, and TOPT_ARCH_RISCV macros.
#    - Declare target_mem_read_nostop() and target_mem_write_nostop().
#
# 2. In src/target/target_internal.h:
#    - Add erasesizes to struct target_flash.
#    - Add sw_breakpoint_helpers, crc32, mem_read_nostop, mem_write_nostop to struct target.
#    - Declare breakpoint and helper prototypes.
#
# 3. In src/target/target_probe.h:
#    - Declare bmp_tweak_options() and wrap PROBE() macro.
#
diff --git a/src/include/target.h b/src/include/target.h
index ce0be5d1..db383f9e 100644
--- a/src/include/target.h
+++ b/src/include/target.h
@@ -38,6 +38,17 @@ typedef SSIZE_T ssize_t;
 typedef int32_t mode_t;
 #endif /* _MSC_VER */
 
+// MEANX
+#define TOP_ARCH_SHIFT   28
+#define TOPT_GET_ARCH(x) ((x >> TOP_ARCH_SHIFT) & 3)
+#define TOPT_SET_ARCH(value, arch)                                           \
+	{                                                                        \
+		value = (value & ~(3 << TOP_ARCH_SHIFT)) | (arch << TOP_ARCH_SHIFT); \
+	}
+#define TOPT_ARCH_ARM   1
+#define TOPT_ARCH_RISCV 2
+// /MEANX
+
 typedef struct target target_s;
 typedef uint32_t target_addr32_t;
 typedef uint64_t target_addr64_t;
@@ -74,6 +85,10 @@ bool target_mem64_read(target_s *target, void *dest, target_addr64_t src, size_t
 bool target_mem32_write(target_s *target, target_addr_t dest, const void *src, size_t len);
 bool target_mem64_write(target_s *target, target_addr64_t dest, const void *src, size_t len);
 bool target_mem_access_needs_halt(target_s *target);
+/* Non-halting memory access: try to perform memory I/O without stopping the CPU.
+ * Returns true if the operation was performed, false if the target cannot do it. */
+bool target_mem_read_nostop(target_s *target, void *dest, target_addr64_t src, size_t len);
+bool target_mem_write_nostop(target_s *target, target_addr64_t dest, const void *src, size_t len);
 /* Flash memory access functions */
 bool target_flash_erase(target_s *target, target_addr_t addr, size_t len);
 bool target_flash_write(target_s *target, target_addr_t dest, const void *src, size_t len);
diff --git a/src/target/target_internal.h b/src/target/target_internal.h
index 59b7bbfe..b4b1924e 100644
--- a/src/target/target_internal.h
+++ b/src/target/target_internal.h
@@ -63,6 +63,7 @@ struct target_flash {
 	target_addr32_t start;            /* Start address of flash */
 	size_t length;                    /* Flash length */
 	size_t blocksize;                 /* Erase block size */
+	const size_t *erasesizes;         /* Optional 0-terminated array of additional erase block sizes */
 	size_t writesize;                 /* Write operation size, must be <= blocksize/writebufsize */
 	size_t writebufsize;              /* Size of write buffer, this is calculated and not set in target code */
 	uint8_t erased;                   /* Byte erased state */
@@ -121,6 +122,19 @@ _Static_assert(sizeof(breakwatch_s) == 40U, "Breakwatch size unexpected");
 
 #define MAX_CMDLINE 81
 
+/* 
+ * These option functions are meant to be used by software breakpoint.
+ * In particular they should aim at minimal write size (page) and
+ * they must not disturb too much the target. NO FLASHSTUB 
+ */
+struct sw_breakpoint_helpers_s {
+	uint32_t (*page_size)(target_s *t);
+	bool (*page_erase)(target_s *target, uint32_t addr);
+	bool (*page_write)(target_s *target, uint32_t addr, const uint8_t *src, uint32_t page_size);
+};
+
+typedef struct sw_breakpoint_helpers_s sw_breakpoint_helpers;
+
 typedef void (*priv_free_func)(void *flash);
 
 struct target {
@@ -135,6 +149,11 @@ struct target {
 	void (*mem_read)(target_s *target, void *dest, target_addr64_t src, size_t len);
 	void (*mem_write)(target_s *target, target_addr64_t dest, const void *src, size_t len);
 
+	/* Non-halting memory access functions: perform memory I/O without stopping the CPU.
+	 * Return true if the operation was performed, false if the target cannot do it. */
+	bool (*mem_read_nostop)(target_s *target, void *dest, target_addr64_t src, size_t len);
+	bool (*mem_write_nostop)(target_s *target, target_addr64_t dest, const void *src, size_t len);
+
 	/* Register access functions */
 	size_t regs_size;
 	const char *(*regs_description)(target_s *target);
@@ -162,6 +181,14 @@ struct target {
 	bool (*enter_flash_mode)(target_s *target);
 	bool (*exit_flash_mode)(target_s *target);
 
+	/* CRC32 function */
+	bool (*crc32)(target_s *target, target_addr32_t start_adress, size_t size, uint32_t *crc32);
+
+	/* Software breakpoint helpers */
+	const struct sw_breakpoint_helpers_s *sw_breakpoint_helpers;
+	bool no_hw_breakpoint;
+	void (*breakpoint_watchpoint_count)(target_s *const target, uint32_t *brk, uint32_t *wtch);
+
 	/* Target-defined options */
 	uint32_t target_options;
 
@@ -207,11 +234,15 @@ struct target {
 extern const command_s platform_cmd_list[];
 #endif
 
+const sw_breakpoint_helpers *target_get_mw_helpers(target_s *const target);
+void target_breakpoint_watchpoint_count(target_s *const target, uint32_t *brk, uint32_t *wtch);
+bool target_has_hw_breakpoint(target_s *const target);
 void target_print_progress(platform_timeout_s *timeout);
 void target_ram_map_free(target_s *target);
 void target_flash_map_free(target_s *target);
 void target_mem_map_free(target_s *target);
 void target_add_commands(target_s *target, const command_s *cmds, const char *name);
+bool breakpoint_available(target_s *target);
 void target_add_ram32(target_s *target, target_addr32_t start, uint32_t len);
 void target_add_ram64(target_s *target, target_addr64_t start, uint64_t len);
 void target_add_flash(target_s *target, target_flash_s *flash);
@@ -239,7 +270,7 @@ bool target_check_error(target_s *target);
 #if defined(__MINGW32__) || defined(__MINGW64__) || defined(__CYGWIN__)
 #define TC_FORMAT_ATTR __attribute__((format(__MINGW_PRINTF_FORMAT, 2, 3)))
 #elif defined(__GNUC__) || defined(__clang__)
-#define TC_FORMAT_ATTR __attribute__((format(printf, 2, 3)))
+#define TC_FORMAT_ATTR //MEANX__attribute__((format(printf, 2, 3)))
 #else
 #define TC_FORMAT_ATTR
 #endif
diff --git a/src/target/target_probe.h b/src/target/target_probe.h
index 4463906d..e76c9036 100644
--- a/src/target/target_probe.h
+++ b/src/target/target_probe.h
@@ -23,14 +23,19 @@
 #include "target.h"
 #include "adiv5.h"
 
+/* -- MEANX -- */
+void bmp_tweak_options(uint32_t *opt);
+
 #define STRINGIFY(x) #x
 /* Probe launch macro used by the CPU-generic layers to then call CPU-specific routines safely */
-#define PROBE(x)                                    \
-	do {                                            \
-		DEBUG_TARGET("Calling %s\n", STRINGIFY(x)); \
-		if ((x)(target))                            \
-			return true;                            \
-		target_check_error(target);                 \
+#define PROBE(x)                                          \
+	do {                                                  \
+		DEBUG_TARGET("Calling %s\n", STRINGIFY(x));       \
+		if ((x)(target)) {                                \
+			bmp_tweak_options(&(target->target_options)); \
+			return true;                                  \
+		}                                                 \
+		target_check_error(target);                       \
 	} while (0)
 
 /*
@@ -113,5 +118,6 @@ bool stm32c5_probe(target_s *target);
 bool zynq7_probe(target_s *target);
 
 void lpc55_dp_prepare(adiv5_debug_port_s *dp);
+bool ch32v3xx_probe(target_s *target);
 
 #endif /* TARGET_TARGET_PROBE_H */
