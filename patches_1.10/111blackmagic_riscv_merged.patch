+/*
+ * BMP 103: the streaming sub-paths of the program buffer reader and writer, switchable at
+ * runtime with `mon riscv_stream on|off`. It is the A/B knob riscv_fault.md §12.9 measures
+ * with: one read, one wire, and only this implementation detail differing - the streaming path
+ * (patch 86) reads DATA0 without ever waiting for the command that read starts, the
+ * word-at-a-time path waits for every one of them. On by default, so nothing changes for a
+ * target that is not being investigated.
+ */
+bool riscv32_progbuf_stream_enabled = true;
+
+/*
+ * BMP 103: what the confirmed read saw. These are the *silent* losses - the ones no status bit
+ * reports, which is why a counter is the only way to tell "the transport is sound" from "the
+ * transport is sound today". `mon riscv_confirm` prints them.
+ */
+typedef struct riscv_confirm_stats {
+	uint32_t windows;          /* read windows confirmed: two passes compared */
+	uint32_t disagreeing;      /* windows whose two passes disagreed */
+	uint32_t elements;         /* elements settled one at a time after a disagreement */
+	uint32_t faults;           /* passes that reported a fault and were re-issued */
+	uint32_t latched;          /* transfers that ended with a latched command error */
+	uint32_t autoexec;         /* abstractauto writes that did not take on the first try */
+	uint32_t last_address;     /* where the most recent disagreement was */
+	uint32_t last_first_pass;  /* what the first pass answered there */
+	uint32_t last_second_pass; /* and what the second pass answered there */
+} riscv_confirm_stats_s;
+
+static riscv_confirm_stats_s riscv_confirm_stats;
+
+/*
+ * The three functions the probe's `mon` commands use. Plain values, so the layout of the
+ * struct above stays private to this file. `out` is filled with as many of the counters as
+ * fit and the total count is returned, which is what makes adding a counter harmless.
+ */
+void bmp_riscv32_set_progbuf_stream(const bool enable)
+{
+	riscv32_progbuf_stream_enabled = enable;
+}
+
+bool bmp_riscv32_get_progbuf_stream(void)
+{
+	return riscv32_progbuf_stream_enabled;
+}
+
+void bmp_riscv32_reset_confirm_stats(void)
+{
+	memset(&riscv_confirm_stats, 0, sizeof(riscv_confirm_stats));
+}
+
+uint32_t bmp_riscv32_confirm_stats(uint32_t *const out, const uint32_t words)
+{
+	const uint8_t *const fields = (const uint8_t *)&riscv_confirm_stats;
+	const uint32_t count = sizeof(riscv_confirm_stats) / sizeof(uint32_t);
+	if (out) {
+		const uint32_t limit = words < count ? words : count;
+		for (uint32_t i = 0; i < limit; ++i)
+			memcpy(&out[i], fields + i * sizeof(uint32_t), sizeof(uint32_t));
+	}
+	return count;
+}
