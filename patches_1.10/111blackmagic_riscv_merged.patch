+ * whole window of read failures (patch 102's "one 13 KB window in three faulted, and the same
+ * window read again is clean"). Reading the register back is what tells a clear that landed
+ * from one that did not - minichlink reads it back for the same reason.
+ */
+static bool riscv32_clear_command_error(riscv_hart_s *const hart)
+{
+	uint32_t status = 0;
+	for (size_t attempt = 0; attempt < RV_READ_CONFIRM_TRIES; ++attempt) {
+		if (!riscv_dm_write(hart->dbg_module, RV_DM_ABST_CTRLSTATUS, RISCV_HART_OTHER << 8U))
+			return false;
+		if (!riscv_dm_read(hart->dbg_module, RV_DM_ABST_CTRLSTATUS, &status))
+			return false;
+		if (!(status & (RISCV_HART_OTHER << 8U)))
+			return true;
+	}
+	RV_MEMLOG("riscv: command error %08" PRIx32 " would not clear\n", status);
+	return false;
