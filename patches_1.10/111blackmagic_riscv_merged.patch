+/* Non-halting memory I/O: use the system bus so the CPU keeps executing.
+ * Returns false if the target cannot do this right now, in which case the
+ * caller should fall back to halting memory access. */
+static bool riscv32_mem_read_nostop(
+	target_s *const target, void *const dest, const target_addr64_t src, const size_t len)
+{
+	riscv_hart_s *const hart = riscv_hart_struct(target);
+	if (!(hart->flags & RV_HART_CAP_HAS_SYSBUS))
+		return false;
+	if (len == 0)
+		return true;
+	riscv32_sysbus_mem_read(hart, dest, (target_addr_t)src, len);
+	riscv_sysbus_check(hart);
+	if (hart->status != RISCV_HART_NO_ERROR) {
+		DEBUG_WARN("riscv: system bus fault during non-halting read; falling back to halting I/O\n");
+		return false;
+	}
+	return true;
+}
+
+static bool riscv32_mem_write_nostop(
+	target_s *const target, const target_addr64_t dest, const void *const src, const size_t len)
+{
+	riscv_hart_s *const hart = riscv_hart_struct(target);
+	if (!(hart->flags & RV_HART_CAP_HAS_SYSBUS))
+		return false;
+	if (len == 0)
+		return true;
+	riscv32_sysbus_mem_write(hart, (target_addr_t)dest, src, len);
+	riscv_sysbus_check(hart);
+	if (hart->status != RISCV_HART_NO_ERROR) {
+		DEBUG_WARN("riscv: system bus fault during non-halting write; falling back to halting I/O\n");
+		return false;
+	}
+	return true;
+}
+
+/* How many times a bounce register is put back after a program buffer run before giving up */
+#define RISCV_PROGBUF_RESTORE_TRIES 2U
+
+/*
+ * BMP 100: put a GPR back the way a program buffer run found it, and make sure it landed.
+ *
+ * The DMI link drops the odd write (the Debug Module answers the access but the transfer never
+ * lands - the ch006 investigation in ch32v0x_silicon_tests is that happening during reads), and a
+ * write issued while an abstract command is still executing is discarded by the Debug Module
+ * (spec 3.12.7), so a restore can be lost with nothing to show for it: a0 is then left holding
+ * the advanced address (one addi a0, a0, 4 per executed program) and a1 the last word the program
+ * transferred. The write is therefore verified by reading the register back, and retried a bounded
+ * number of times. Only the low word is compared: the upper half of a transfer wider than the Hart
+ * is not defined by the spec, while on a 32-bit Hart the low word is the whole register.
+ */
+static bool riscv32_progbuf_restore_gpr(
+	riscv_hart_s *const hart, const uint16_t reg, const uint32_t value[RV_DPC_WORDS])
+{
+	for (uint32_t attempt = 0; attempt < RISCV_PROGBUF_RESTORE_TRIES; ++attempt) {
+		uint32_t readback[RV_DPC_WORDS] = {0U};
+		if (riscv_csr_write(hart, reg, value) && riscv_csr_read(hart, reg, readback) &&
+			readback[0] == value[0])
+			return true;
+	}
+	RV_MEMLOG("riscv: GPR %04x could not be put back after program buffer execution (%08" PRIx32 ")\n", reg,
+		value[0]);
+	return false;
+}
+
+/*
+ * BMP 100: a register write that must not race the abstract command an autoexec'd data0 access has
+ * just started. Touching command, abstractauto, progbuf or the data registers while a command is
+ * executing sets cmderr to 1 and the access is discarded - "Attempts to write them while busy is
+ * set does not change their value" (spec 3.12.7, 3.12.8, 3.12.11, 3.12.12; the vendor documents
+ * the same rule at sdi.txt:1258), which is exactly how a register restore, or the write that drops
+ * the autoexec stream, can go missing. riscv_command_wait_complete() waits for busy to clear *and*
+ * consumes cmderr, so it is used to quiesce the pipeline first. The write is attempted even if that
+ * did not work out: a write the Debug Module rejects is ignored, while leaving the autoexec stream
+ * armed would re-run a stale command on the next data0 access - i.e. during the restores.
+ */
+static bool riscv32_progbuf_quiesced_write(riscv_hart_s *const hart, const uint8_t address, const uint32_t value)
+{
+	const bool quiesced = riscv_command_wait_complete(hart);
+	return riscv_dm_write(hart->dbg_module, address, value) && quiesced;
+}
+
+/*
+ * BMP 103: arm or drop the abstractauto stream and, on a transport that cannot be trusted to
+ * deliver the write, make sure it landed. The drop is the one that matters: a lost drop leaves
+ * the stream armed, so the next DATA0 access - the a0/a1 restores at the end of the read -
+ * re-runs a stale command and the register comes back wrong. BMP 100's quiesce stops the drop
+ * racing an executing command; this is about it never having arrived at all. The read-back is a
+ * *register* read, not a data access, so it cannot disturb the stream it is checking.
+ */
+static bool riscv32_autoexec_confirmed_write(riscv_hart_s *const hart, const uint32_t value)
+{
+	uint32_t readback = 0;
+	for (size_t attempt = 0; attempt < RV_AUTOEXEC_CONFIRM_TRIES; ++attempt) {
+		/* The write must not race a command an earlier DATA0 read has just started (BMP 100) */
+		const bool quiesced = riscv_command_wait_complete(hart);
+		if (riscv_dm_write(hart->dbg_module, RV_DM_ABSTRACTAUTO, value) && quiesced &&
+			riscv_dm_read(hart->dbg_module, RV_DM_ABSTRACTAUTO, &readback) && readback == value)
+			return true;
+		riscv_confirm_stats.autoexec++;
+		RV_MEMLOG("riscv: abstractauto = %08" PRIx32 " did not take (read back %08" PRIx32 "), writing it again\n",
+			value, readback);
+	}
+	return false;
+}
+
+/*
+ * Every abstractauto write this file makes goes through here, so the confirmation costs a
+ * transport that can report nothing, and a target on a transport that can keeps the traffic it
+ * had (the drop still goes through the quiescing write BMP 100 introduced).
