 }
 
+/* Write DP-SELECT for the given AP register bank, skipping the transaction when
+ * nothing changed. The shadow register is kept in sync on every SELECT write,
+ * both here and in adiv5_dp_write(), so a skip is only ever done when the DP's
+ * SELECT register already holds the requested value (BMP 83). */
+void adiv5_ap_select(adiv5_access_port_s *const ap, const uint16_t addr)
+{
+	if (ap->dp->version >= 3U) {
+		/*
+		 * ADIv6: the AP is selected with SELECT1 (upper 32 bits of the AP's
+		 * bus address) plus SELECT (lower 32 bits | register bank). SELECT1 is
+		 * only reachable while DP-SELECT is on bank 5, so hop there only when
+		 * the upper address actually needs rewriting. Both writes are skipped
+		 * entirely when nothing has changed (BMP 88).
+		 */
+		adiv6_access_port_s *const ap6 = (adiv6_access_port_s *)ap;
+		const uint32_t select1 = (uint32_t)(ap6->ap_address >> 32U);
+		if (select1 != ap->dp->select1_cache || !ap->dp->select1_cached) {
+			if (ap->dp->select_cache != ADIV5_DP_BANK5 || !ap->dp->select_cached) {
+				adiv5_dp_recoverable_access(ap->dp, ADIV5_LOW_WRITE, ADIV5_DP_SELECT, ADIV5_DP_BANK5);
+				ap->dp->select_cache = ADIV5_DP_BANK5;
+				ap->dp->select_cached = 1;
+			}
+			adiv5_dp_recoverable_access(ap->dp, ADIV5_LOW_WRITE, ADIV6_DP_SELECT1, select1);
+			ap->dp->select1_cache = select1;
+			ap->dp->select1_cached = 1;
+		}
+		const uint32_t select = (uint32_t)ap6->ap_address | (addr & ADIV6_AP_BANK_MASK);
+		if (select != ap->dp->select_cache || !ap->dp->select_cached) {
+			adiv5_dp_recoverable_access(ap->dp, ADIV5_LOW_WRITE, ADIV5_DP_SELECT, select);
+			ap->dp->select_cache = select;
+			ap->dp->select_cached = 1;
+		}
+		return;
+	}
+	const uint32_t select = ((uint32_t)ap->apsel << 24U) | (addr & 0xf0U);
+	if (select != ap->dp->select_cache || !ap->dp->select_cached) {
+		adiv5_dp_recoverable_access(ap->dp, ADIV5_LOW_WRITE, ADIV5_DP_SELECT, select);
+		ap->dp->select_cache = select;
+		ap->dp->select_cached = 1;
+	}
+}
+
+/* Clear the DP-SELECT/SELECT1 write caches after an event that may have reset the
+ * DP itself (protocol-error line reset, nRST, power cycle, ...). The shadow
+ * caches still claim to hold the last written values, but the real registers
+ * have reverted to their reset values, so the next access re-writes SELECT and
+ * SELECT1 unconditionally. Both shadow registers are DP-global (SELECT1 only
+ * exists on ADIv6, where clearing its validity flag is a no-op on ADIv5) and
+ * are shared by every AP on the DP (BMP 90). */
+void adiv5_dp_invalidate_caches(adiv5_debug_port_s *const dp)
+{
+	dp->select_cached = 0;
+	dp->select1_cached = 0;
+}
+
+/* Clear the DP-SELECT/SELECT1 write caches plus this AP's CSW cache. */
+void adiv5_ap_invalidate_caches(adiv5_access_port_s *const ap)
+{
+	adiv5_dp_invalidate_caches(ap->dp);
+	ap->csw_cached = 0;
+}
+
 void adiv5_ap_reg_write(adiv5_access_port_s *ap, uint16_t addr, uint32_t value)
 {
-	adiv5_dp_recoverable_access(
-		ap->dp, ADIV5_LOW_WRITE, ADIV5_DP_SELECT, ((uint32_t)ap->apsel << 24U) | (addr & 0xf0U));
+	adiv5_ap_select(ap, addr);
 	adiv5_dp_write(ap->dp, addr, value);
+	if (addr == ADIV5_AP_CSW) {
+		ap->csw_cache = value;
+		ap->csw_cached = 1;
+	}
 }
 
 uint32_t adiv5_ap_reg_read(adiv5_access_port_s *ap, uint16_t addr)
 {
-	adiv5_dp_recoverable_access(
-		ap->dp, ADIV5_LOW_WRITE, ADIV5_DP_SELECT, ((uint32_t)ap->apsel << 24U) | (addr & 0xf0U));
+	adiv5_ap_select(ap, addr);
 	return adiv5_dp_read(ap->dp, addr);
 }
 
