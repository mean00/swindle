diff --git a/src/target/adiv5.c b/src/target/adiv5.c
index 975e5912..25cec06a 100644
--- a/src/target/adiv5.c
+++ b/src/target/adiv5.c
@@ -198,6 +198,9 @@ static bool cortexm_prepare(adiv5_access_port_s *ap)
 	platform_timeout_set(&reset_timeout, cortexm_wait_timeout);
 	/* Deassert the physical reset line */
 	platform_nrst_set_val(false);
